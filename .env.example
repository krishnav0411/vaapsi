# Vaapsi environment
# Copy to .env and fill in. .env is gitignored, so real values never reach
# the repo. This file only carries the key names.

# Razorpay TEST mode keys (rzp_test_...), from the dashboard test toggle
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Generated when you register the webhook (Dashboard > Settings > Webhooks,
# Add New Webhook, copy the secret it shows once)
RAZORPAY_WEBHOOK_SECRET=

# Tunnel auth, only needed if you use the ngrok path in tools/
NGROK_AUTHTOKEN=

# App
APP_ENV=development
VAAPSI_DATA_DIR=data

# LLM adapter, any OpenAI-compatible endpoint. The key is injected through
# the environment at runtime, never stored in this file.
VAAPSI_LLM_BASE_URL=https://api.openai.com/v1
VAAPSI_LLM_MODEL=gpt-4o-mini
VAAPSI_LLM_API_KEY=

# Policy. Set VAAPSI_KILL_SWITCH=1 to deny every outbound action (the mode
# flips to KILLED in /health and the dashboard). Leave it commented for
# normal operation. An empty value would fail bool parsing, so use 0 or
# remove the line entirely.
# VAAPSI_KILL_SWITCH=

# Public demo mode. Set VAAPSI_PUBLIC_DEMO=1 to boot a fail-closed,
# read-only demo: every write route answers 404, the webhook receiver is
# not mounted, and a missing store is seeded with sanitized demo data on
# boot (see scripts/seed_demo.py). A demo deployment that also carries any
# real credential (RAZORPAY_* or the LLM key) refuses to start. Leave it
# unset (or 0) for normal operation — same empty-value rule as above.
# VAAPSI_PUBLIC_DEMO=
